@article{einstein1905elektrodynamik,
  title={Zur Elektrodynamik bewegter K{\"o}rper},
  author={Einstein, Albert},
  journal={Annalen der Physik},
  volume={322},
  number={10},
  pages={891--921},
  year={1905},
  publisher={Wiley Online Library},
  abstract={It is known that Maxwell's electrodynamics--as usually understood at the present time--when applied to moving bodies, leads to asymmetries which do not appear to be inherent in the phenomena. Take, for example, the reciprocal electrodynamic action of a magnet and a conductor. The observable phenomenon here depends only on the relative motion of the conductor and the magnet, whereas the customary view draws a sharp distinction between the two cases in which either the one or the other of these bodies is in motion. For if the magnet is in motion and the conductor at rest, there arises in the neighbourhood of the magnet an electric field with a certain definite energy, producing a current at the places where parts of the conductor are situated. But if the magnet is stationary and the conductor in motion, no electric field arises in the neighbourhood of the magnet. In the conductor, however, we find an electromotive force, to which in itself there is no corresponding energy, but which gives rise--assuming equality of relative motion in the two cases discussed--to electric currents of the same path and intensity as those produced by the electric forces in the former case.},
  selected={true},
  pdf={example_pdf.pdf},
  code={https://github.com/alshedivat/al-folio},
  website={https://www.alberteinstein.com/},
  blog={https://www.alberteinstein.com/},
  poster={https://www.alberteinstein.com/},
  slides={https://www.alberteinstein.com/},
  video={https://www.alberteinstein.com/},
  supp={https://www.alberteinstein.com/},
  arxiv={https://arxiv.org/},
  html={https://www.alberteinstein.com/},
  preview={https://www.alberteinstein.com/},
  annotation={This paper is about the electrodynamics of moving bodies.}
}

